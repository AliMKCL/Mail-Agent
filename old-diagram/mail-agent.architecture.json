  "cards": [
    {
      "dot": "cyan",
      "title": "Gateway & Accounts (Login)",
      "items": [
        "Gateway (:8000) is the sole public entry point (binds 0.0.0.0)",
        "Accounts (:8010) authenticates users and verifies credentials/tokens against Database"
      ]
    },
    {
      "dot": "emerald",
      "title": "User_data & Sync Pipeline (Optional)",
      "items": [
        "Sync button triggers User_data (:8020) to resolve tokens via Accounts & fetch from Gmail",
        "Cleans messages and coordinates storage across Database (:8030) and Vector DB (:8040)"
      ]
    },
    {
      "dot": "amber",
      "title": "Database & Vector DB Storage",
      "items": [
        "Database (:8030) owns gmail_agent.db (SQLite) for email caching and user records",
        "Vector DB (:8040) embeds via Ollama (:11434) and manages Chroma semantic vectors"
      ]
    },
    {
      "dot": "rose",
      "title": "MCP & AI Query Orchestration",
      "items": [
        "MCP (:8050) orchestrates 14 tools & 9 resources; sole caller of OpenAI chat completions",
        "Rate Limiter (:8002) fails open; optional Go Sync (:8001) enables high-throughput ingestion"
      ]
    }
  ]
