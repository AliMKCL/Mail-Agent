{
  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Mail Agent - Intelligent Gmail & Calendar Manager</title>\n    <meta name=\"description\"\n        content=\"AI-powered personal email assistant that automatically organizes emails, extracts important dates/events, and provides intelligent search across multiple Gmail accounts.\">\n    <link rel=\"stylesheet\" href=\"static/landing.css?v=2\">\n</head>\n\n<body>\n    <!-- Main Container for Split Screen -->\n    <div id=\"mainContainer\" class=\"main-container\">\n        <!-- Landing Content (Left Side) -->\n        <div id=\"landingContent\" class=\"landing-content\">\n            <div class=\"landing-container\">\n                <header class=\"landing-header\">\n                    <div class=\"logo-container\">\n                        <div class=\"logo-icon\">\n                            <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                xmlns=\"http://www.w3.org/2000/svg\">\n                                <path\n                                    d=\"M20 4H4C2.9 4 2.01 4.9 2.01 6L2 18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z\"\n                                    fill=\"currentColor\" />\n                            </svg>\n                        </div>\n                        <span class=\"logo-text\">Mail Agent</span>\n                    </div>\n                </header>\n\n                <main class=\"landing-main\">\n                    <div class=\"hero-section\">\n                        <h1 class=\"hero-title\">Your Intelligent Mail Assistant</h1>\n                        <p class=\"hero-subtitle\">AI-powered email management that automatically organizes your inbox,\n                            extracts important dates, and provides intelligent search across multiple Gmail accounts.\n                        </p>\n\n                        <button id=\"getStartedBtn\" class=\"cta-button\">\n                            Get Started\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                xmlns=\"http://www.w3.org/2000/svg\">\n                                <path d=\"M12 4L10.59 5.41L16.17 11H4V13H16.17L10.59 18.59L12 20L20 12L12 4Z\"\n                                    fill=\"currentColor\" />\n                            </svg>\n                        </button>\n                    </div>\n\n                    <div class=\"features-section\">\n                        <div class=\"feature-card\">\n                            <div class=\"feature-icon\">\n                                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path\n                                        d=\"M20 6H10L8 4H4C2.9 4 2.01 4.9 2.01 6L2 18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6ZM20 18H4V8H20V18Z\"\n                                        fill=\"currentColor\" />\n                                </svg>\n                            </div>\n                            <h3 class=\"feature-title\">Smart Organization</h3>\n                            <p class=\"feature-description\">Automatically categorize and organize your emails with\n                                AI-powered intelligence.</p>\n                        </div>\n\n                        <div class=\"feature-card\">\n                            <div class=\"feature-icon\">\n                                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path\n                                        d=\"M19 3H18V1H16V3H8V1H6V3H5C3.89 3 3.01 3.9 3.01 5L3 19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM19 19H5V8H19V19Z\"\n                                        fill=\"currentColor\" />\n                                </svg>\n                            </div>\n                            <h3 class=\"feature-title\">Calendar Integration</h3>\n                            <p class=\"feature-description\">Extract dates and events from emails and sync them directly\n                                to your calendar.</p>\n                        </div>\n\n                        <div class=\"feature-card\">\n                            <div class=\"feature-icon\">\n                                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path\n                                        d=\"M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z\"\n                                        fill=\"currentColor\" />\n                                </svg>\n                            </div>\n                            <h3 class=\"feature-title\">Intelligent Search</h3>\n                            <p class=\"feature-description\">Find any email instantly with powerful semantic search\n                                powered by vector embeddings.</p>\n                        </div>\n\n                        <div class=\"feature-card\">\n                            <div class=\"feature-icon\">\n                                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path\n                                        d=\"M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 11.99H19C18.47 16.11 15.72 19.78 12 20.93V12H5V6.3L12 3.19V11.99Z\"\n                                        fill=\"currentColor\" />\n                                </svg>\n                            </div>\n                            <h3 class=\"feature-title\">Privacy First</h3>\n                            <p class=\"feature-description\">Your data stays secure with local processing and encrypted\n                                storage.</p>\n                        </div>\n                    </div>\n                </main>\n\n                <footer class=\"landing-footer\">\n                    <p>&copy; 2026 Mail Agent. All rights reserved.</p>\n                </footer>\n            </div>\n        </div>\n\n        <!-- Separator -->\n        <div id=\"separator\" class=\"separator\"></div>\n\n        <!-- Auth Content (Right Side) -->\n        <div id=\"authContent\" class=\"auth-content-side\">\n            <div class=\"auth-card\">\n                <div class=\"auth-header\">\n                    <div class=\"auth-logo\">\n                        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path\n                                d=\"M20 4H4C2.9 4 2.01 4.9 2.01 6L2 18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z\"\n                                fill=\"currentColor\" />\n                        </svg>\n                    </div>\n                    <h1 class=\"auth-title\">Agentic Mail</h1>\n                    <p class=\"auth-subtitle\">Your Intelligent Mail Assistant</p>\n                </div>\n\n                <div class=\"auth-content\">\n                    <h2 class=\"welcome-text\">Welcome</h2>\n                    <p class=\"connect-text\">Connect your Gmail or Outlook inbox</p>\n\n                    <div class=\"oauth-buttons\">\n                        <button class=\"oauth-btn google-btn\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path\n                                    d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n                                    fill=\"#4285F4\" />\n                                <path\n                                    d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n                                    fill=\"#34A853\" />\n                                <path\n                                    d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n                                    fill=\"#FBBC05\" />\n                                <path\n                                    d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n                                    fill=\"#EA4335\" />\n                            </svg>\n                            Continue with Google\n                        </button>\n\n                        <button class=\"oauth-btn microsoft-btn\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path\n                                    d=\"M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z\"\n                                    fill=\"#00A4EF\" />\n                            </svg>\n                            Continue with Microsoft\n                        </button>\n                    </div>\n\n                    <div class=\"divider\">\n                        <span>or continue with email</span>\n                    </div>\n\n                    <div class=\"auth-tabs\">\n                        <button id=\"signInTab\" class=\"auth-tab active\">Sign In</button>\n                        <button id=\"signUpTab\" class=\"auth-tab\">Sign Up</button>\n                    </div>\n\n                    <form id=\"authForm\" class=\"auth-form\">\n                        <div class=\"form-group\">\n                            <label for=\"email\">Email address</label>\n                            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" required>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"password\">Password</label>\n                            <div class=\"password-input-wrapper\">\n                                <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"••••••••\" required>\n                                <button type=\"button\" class=\"toggle-password\" id=\"togglePassword\">\n                                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                        xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path\n                                            d=\"M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z\"\n                                            fill=\"currentColor\" />\n                                    </svg>\n                                </button>\n                            </div>\n                        </div>\n\n                        <div class=\"form-footer\">\n                            <a href=\"#\" class=\"forgot-password\">Forgot password?</a>\n                        </div>\n\n                        <button type=\"submit\" class=\"submit-btn\" id=\"submitBtn\">Sign In</button>\n                    </form>\n                </div>\n\n                <div class=\"auth-footer\">\n                    <div class=\"provider-links\">\n                        <a href=\"#\" class=\"provider-link\">\n                            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path\n                                    d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n                                    fill=\"#4285F4\" />\n                                <path\n                                    d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n                                    fill=\"#34A853\" />\n                                <path\n                                    d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n                                    fill=\"#FBBC05\" />\n                                <path\n                                    d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n                                    fill=\"#EA4335\" />\n                            </svg>\n                            Gmail\n                        </a>\n                        <a href=\"#\" class=\"provider-link\">\n                            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path\n                                    d=\"M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z\"\n                                    fill=\"#00A4EF\" />\n                            </svg>\n                            Outlook\n                        </a>\n                    </div>\n                    <div class=\"legal-links\">\n                        <a href=\"#\">Privacy Policy</a>\n                        <span>•</span>\n                        <a href=\"#\">Terms of Service</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"static/landing.js\"></script>\n</body>\n\n</html>",
